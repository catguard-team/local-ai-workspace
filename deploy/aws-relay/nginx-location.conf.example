# Include ONLY inside the TLS server block for ai.example.com.
# Existing server blocks, DNS, certificate provisioning, and HTTP redirects
# are managed separately by the deployer.
location / {
    client_max_body_size 11m;
    proxy_pass http://unix:/run/localai-relay/upstream.sock:;
    proxy_http_version 1.1;
    proxy_set_header Host ai.example.com;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    # This root-owned 0600 file contains exactly:
    # proxy_set_header X-LocalAI-Relay-Token "<actual-64-lowercase-hex-token>";
    include /etc/nginx/snippets/localai-relay-token.conf;
    proxy_connect_timeout 10s;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_next_upstream off;
}
